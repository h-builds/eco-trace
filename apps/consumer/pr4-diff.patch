diff --git a/apps/consumer/src/style.css b/apps/consumer/src/style.css
index a99a6cd..ef0b6b9 100644
--- a/apps/consumer/src/style.css
+++ b/apps/consumer/src/style.css
@@ -1,2 +1,60 @@
 @import "tailwindcss";
 @import "@eco-trace/ui/variables.css";
+@import "./tokens.css";
+
+/* ==================================================================
+   GLOBAL BASE — Precision Blueprint defaults
+   ================================================================== */
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+  /* Enforce the Workbench rule: no rounded corners ever */
+  border-radius: 0 !important;
+}
+
+html {
+  font-size: 16px;
+  -webkit-text-size-adjust: 100%;
+  scroll-behavior: smooth;
+}
+
+body {
+  font-family: var(--font-bp-body);
+  font-size: var(--font-size-bp-md);
+  font-weight: var(--font-weight-bp-regular);
+  line-height: var(--leading-bp-normal);
+  color: var(--color-bp-on-surface);
+  background-color: var(--color-bp-surface);
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+}
+
+/* Editorial headings use Space Grotesk ("Industrial" voice) */
+h1, h2, h3, h4, h5, h6 {
+  font-family: var(--font-bp-display);
+  font-weight: var(--font-weight-bp-bold);
+  line-height: var(--leading-bp-tight);
+  letter-spacing: var(--tracking-bp-tight);
+  color: var(--color-bp-on-surface);
+}
+
+/* All numeric / technical data uses Geist Mono */
+code, kbd, samp, pre, time, data {
+  font-family: var(--font-bp-mono);
+  letter-spacing: var(--tracking-bp-tight);
+}
+
+/* No focus rings from browser defaults — use bp-outline tokens */
+:focus {
+  outline: none;
+}
+:focus-visible {
+  outline: 2px solid var(--outline-bp-focus);
+  outline-offset: 2px;
+}
+
+/* Smooth transitions on interactive elements */
+a, button {
+  transition: var(--transition-bp-colors);
+}
diff --git a/apps/consumer/src/tokens.css b/apps/consumer/src/tokens.css
new file mode 100644
index 0000000..169e493
--- /dev/null
+++ b/apps/consumer/src/tokens.css
@@ -0,0 +1,373 @@
+/*
+ * ============================================================
+ * ECO-TRACE CONSUMER — PRECISION BLUEPRINT DESIGN TOKENS
+ * Design System: Industrial Editorial (Light Mode)
+ * Creative North Star: "The Precision Blueprint"
+ * ============================================================
+ *
+ * These tokens implement the full Precision Blueprint spec.
+ * They extend and, where necessary, override @eco-trace/ui
+ * base tokens for the consumer surface.
+ *
+ * TOKEN TAXONOMY
+ * ─────────────────────────────────────────────────────────────
+ * --bp-color-*       Surface & role-based color tokens
+ * --bp-font-*        Typography (families, sizes, weights, tracking)
+ * --bp-spacing-*     Spacing scale (4px base grid)
+ * --bp-radius-*      Border-radius (ALL zero — "Workbench" rule)
+ * --bp-shadow-*      Elevation via ambient tinted shadows
+ * --bp-gradient-*    Signature gradient fills
+ * --bp-outline-*     Ghost border tokens
+ * --bp-blur-*        Backdrop blur constants
+ * ============================================================
+ */
+
+/* ------------------------------------------------------------------
+   GOOGLE FONTS — Space Grotesk · Geist Mono · Inter
+   ------------------------------------------------------------------ */
+@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap');
+/* Geist Mono is served via Vercel CDN */
+@import url('https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-mono/style.css');
+
+@theme inline {
+
+  /* ==============================================================
+     1. SURFACE HIERARCHY
+     The UI is treated as a series of physical tonal layers.
+     NO explicit 1px borders — depth is achieved through color alone.
+     ==============================================================
+
+     Layer 0 — Canvas (primary workbench)
+     Layer 1 — Sections (large content areas)
+     Layer 2 — Active cards (floating interactive elements)
+     Layer 3 — High-detail modals (with backdrop-blur)
+     ============================================================== */
+
+  /* Canvas / Base */
+  --color-bp-surface:                   #f9f9fc;  /* Layer 0 — main workbench  */
+  --color-bp-surface-bright:            #f9f9fc;  /* Layer 3 — modal base       */
+
+  /* Container tiers */
+  --color-bp-surface-container-lowest:  #ffffff;  /* Layer 2 — active cards     */
+  --color-bp-surface-container-low:     #f3f3f6;  /* Layer 1 — content sections */
+  --color-bp-surface-container:         #ededf0;  /* Mid-container              */
+  --color-bp-surface-container-high:    #e7e7ea;  /* Hover state substrate      */
+  --color-bp-surface-container-highest: #e2e2e5;  /* Command Strip weight       */
+
+  /* On-surface text roles */
+  --color-bp-on-surface:                #1a1c1e;  /* Primary body text          */
+  --color-bp-on-surface-variant:        #44474a;  /* Secondary / metadata text  */
+
+  /* ==============================================================
+     2. COLOR ROLES — PRIMARY (INTEGRITY GREEN)
+     Primary #8ED5B4 ensures ≥4.5:1 contrast on all surface tiers.
+     Primary-container is the gradient end-stop (machined sheen).
+     ============================================================== */
+  --color-bp-primary:                   #1B633F;  /* Accessible interactive green */
+  --color-bp-primary-container:         #D1EBDD;  /* Light green surface */
+  --color-bp-on-primary:                #ffffff;  /* High-contrast text on primary */
+  --color-bp-on-primary-container:      #002105;  /* Text on container fills */
+
+  /* ==============================================================
+     3. FUNCTIONAL / SEMANTIC COLORS
+     ============================================================== */
+  --color-bp-success:                   #287a33;  /* Verification green          */
+  --color-bp-warning:                   #f57c00;  /* Pending / caution           */
+  --color-bp-error:                     #d32f2f;  /* Alert / destructive         */
+  --color-bp-neutral:                   #607d8b;  /* Muted metadata              */
+
+  /* Tertiary — Success variant for secondary status indicators */
+  --color-bp-tertiary:                  #287a33;
+  --color-bp-tertiary-container:        #9bef9a;
+  --color-bp-on-tertiary-container:     #002105;
+  
+  --color-bp-error-container:           #ffdad6;
+  --color-bp-on-error-container:        #410002;
+  --color-bp-success-container:         #b8f0ca;
+  --color-bp-on-success-container:      #00210b;
+  --color-bp-surface-variant:           #e1e3de;
+  --color-bp-on-surface-variant:        #444743;
+
+  /* Outline system */
+  --color-bp-outline:                   #c4c6c9;  /* Standard border             */
+  --color-bp-outline-variant:           #c4c6c9;  /* Base; apply 0.15 alpha       */
+
+  /* ==============================================================
+     4. TYPOGRAPHY
+     ─────────────────────────────────────────────────────────────
+     Space Grotesk  →  Headlines & Display ("Industrial" voice)
+     Geist Mono     →  Metrics, IDs, timestamps, chip labels
+     Inter          →  Body, titles, instructional copy
+     ============================================================== */
+
+  /* Font families */
+  --font-bp-display:    'Space Grotesk', system-ui, sans-serif;
+  --font-bp-mono:       'Geist Mono', 'JetBrains Mono', 'Fira Code', monospace;
+  --font-bp-body:       Inter, system-ui, sans-serif;
+
+  /* Typographic scale */
+  --font-size-bp-xs:    0.625rem;   /*  10px — chip labels, prefix tags */
+  --font-size-bp-sm:    0.75rem;    /*  12px — label-sm, meta           */
+  --font-size-bp-md:    0.875rem;   /*  14px — body-md, label-md        */
+  --font-size-bp-lg:    1rem;       /*  16px — title-md, nav            */
+  --font-size-bp-xl:    1.25rem;    /*  20px — title-lg                 */
+  --font-size-bp-2xl:   1.5rem;     /*  24px — headline-md              */
+  --font-size-bp-3xl:   2rem;       /*  32px — headline-lg (editorial)  */
+  --font-size-bp-4xl:   2.5rem;     /*  40px — display-sm               */
+  --font-size-bp-5xl:   3rem;       /*  48px — display-lg               */
+
+  /* Font weights */
+  --font-weight-bp-regular:  400;
+  --font-weight-bp-medium:   500;
+  --font-weight-bp-semibold: 600;
+  --font-weight-bp-bold:     700;
+
+  /* Letter spacing */
+  --tracking-bp-tight:       -0.02em;    /* Geist Mono high-density readability */
+  --tracking-bp-normal:       0em;
+  --tracking-bp-wide:         0.05em;    /* All-caps label prefixes             */
+  --tracking-bp-widest:       0.12em;    /* "01 / SYSTEM STATUS" editorial tags */
+
+  /* Line heights */
+  --leading-bp-tight:        1.1;        /* Display & large headlines           */
+  --leading-bp-snug:         1.3;        /* Section headings                    */
+  --leading-bp-normal:       1.5;        /* Body copy                           */
+  --leading-bp-relaxed:      1.7;        /* Long-form instructional text        */
+
+  /* ==============================================================
+     5. SPACING SCALE
+     4px base grid. All values snap to this rhythm.
+     ============================================================== */
+  --spacing-bp-0:    0px;
+  --spacing-bp-1:    0.25rem;   /*  4px  */
+  --spacing-bp-2:    0.5rem;    /*  8px  */
+  --spacing-bp-3:    0.75rem;   /* 12px  */
+  --spacing-bp-4:    1rem;      /* 16px  — list row gap                 */
+  --spacing-bp-5:    1.25rem;   /* 20px  */
+  --spacing-bp-6:    1.5rem;    /* 24px  — component internal padding   */
+  --spacing-bp-8:    2rem;      /* 32px  */
+  --spacing-bp-10:   2.5rem;    /* 40px  */
+  --spacing-bp-12:   3rem;      /* 48px  */
+  --spacing-bp-16:   4rem;      /* 64px  — between major sections       */
+  --spacing-bp-20:   5rem;      /* 80px  — editorial chapter breaks     */
+  --spacing-bp-24:   6rem;      /* 96px  */
+  --spacing-bp-32:   8rem;      /* 128px */
+
+  /* ==============================================================
+     6. BORDER RADIUS — ALL ZERO
+     "Precision is found in right angles." — The Workbench Rule.
+     Rounded corners are forbidden in this design system.
+     ============================================================== */
+  --radius-bp-none:   0px;
+  --radius-bp-sm:     0px;
+  --radius-bp-md:     0px;
+  --radius-bp-lg:     0px;
+  --radius-bp-pill:   0px;
+  --radius-bp-full:   0px;
+
+  /* ==============================================================
+     7. SHADOWS — TECHNICAL AMBIENT LIGHTING
+     "Traditional shadows are too soft for an industrial workbench."
+     Use a tinted version of on-surface at low opacity.
+     Max perceptibility: mimics high-end lab ambient lighting.
+     ============================================================== */
+
+  /* For floating dropdowns / popovers */
+  --shadow-bp-ambient:   0px 4px 20px rgba(26, 28, 30, 0.06);
+
+  /* For cards lifted from surface-container-low */
+  --shadow-bp-lift:      0px 2px 8px rgba(26, 28, 30, 0.04),
+                         0px 1px 2px rgba(26, 28, 30, 0.06);
+
+  /* For modal-tier overlays */
+  --shadow-bp-modal:     0px 8px 32px rgba(26, 28, 30, 0.08),
+                         0px 2px 8px  rgba(26, 28, 30, 0.04);
+
+  /* Zero shadow (explicitly named for intentional reset) */
+  --shadow-bp-none:      none;
+
+  /* ==============================================================
+     8. GRADIENTS — SIGNATURE FILLS
+     "The Integrity Gradient" — machined sheen on primary actions.
+     ============================================================== */
+  --gradient-bp-integrity:
+    linear-gradient(135deg, #8ED5B4 0%, #7ABF9F 100%);
+
+  --gradient-bp-integrity-hover:
+    linear-gradient(135deg, #7ABF9F 0%, #68A186 100%);
+
+  /* Subtle surface sheen for section headers (barely perceptible) */
+  --gradient-bp-surface-sheen:
+    linear-gradient(180deg, #f9f9fc 0%, #f3f3f6 100%);
+
+  /* ==============================================================
+     9. GHOST BORDER — ACCESSIBILITY FALLBACK
+     "A 100% opaque border is a failure of the layout's tonal logic."
+     Use outline-variant at 15% opacity ONLY when a border is
+     strictly required for accessibility (e.g. focus rings, WCAG).
+     ============================================================== */
+  --outline-bp-ghost:      rgba(196, 198, 201, 0.15);  /* 15% opacity  */
+  --outline-bp-focus:      rgba(142, 213, 180, 0.35);     /* Primary tint */
+
+  /* ==============================================================
+     10. BACKDROP BLUR — GLASS OVERLAY
+     "The Glass Overlay" — command-center panel system.
+     Keeps industrial context visible beneath the active layer.
+     ============================================================== */
+  --blur-bp-glass:   20px;   /* Primary glass overlay blur     */
+  --blur-bp-nav:     8px;    /* Navigation bar backdrop blur   */
+
+  /* Glass surface: surface-container-lowest at 85% opacity + blur */
+  --color-bp-surface-glass:  rgba(255, 255, 255, 0.85);
+
+  /* ==============================================================
+     11. TRANSITIONS & ANIMATION
+     Micro-animations that feel engineered, not decorative.
+     ============================================================== */
+  --duration-bp-instant:  80ms;
+  --duration-bp-fast:     150ms;
+  --duration-bp-base:     220ms;
+  --duration-bp-slow:     350ms;
+
+  --ease-bp-standard:     cubic-bezier(0.2, 0, 0, 1);    /* Material 3 standard */
+  --ease-bp-decelerate:   cubic-bezier(0, 0, 0, 1);      /* Enter / appear       */
+  --ease-bp-accelerate:   cubic-bezier(0.3, 0, 1, 1);    /* Exit / disappear     */
+
+  /* Composite shorthand (mimic Tailwind transition-* pattern) */
+  --transition-bp-colors:
+    color       var(--duration-bp-fast) var(--ease-bp-standard),
+    background  var(--duration-bp-fast) var(--ease-bp-standard),
+    opacity     var(--duration-bp-fast) var(--ease-bp-standard);
+
+  --transition-bp-shadow:
+    box-shadow  var(--duration-bp-base) var(--ease-bp-standard);
+
+  --transition-bp-transform:
+    transform   var(--duration-bp-base) var(--ease-bp-standard);
+
+  /* ==============================================================
+     12. Z-INDEX LAYERS
+     Named layers prevent magic-number stacking context collisions.
+     ============================================================== */
+  --z-bp-base:       0;
+  --z-bp-raised:     10;
+  --z-bp-dropdown:   100;
+  --z-bp-sticky:     200;
+  --z-bp-overlay:    300;
+  --z-bp-modal:      400;
+  --z-bp-toast:      500;
+  --z-bp-nav:        600;
+
+}
+
+
+/* ==================================================================
+   UTILITY LAYER — Precision Blueprint Helpers
+   Tailwind v4: define @utility blocks for composable, named patterns
+   These are opt-in; they do NOT override global Tailwind utilities.
+   ================================================================== */
+
+/* ── Integrity Gradient Button Fill ─────────────────────────────── */
+@utility bp-btn-primary {
+  background-image: var(--gradient-bp-integrity);
+  color: var(--color-bp-on-primary);
+  border-radius: var(--radius-bp-none);
+  font-family: var(--font-bp-display);
+  font-size: var(--font-size-bp-md);
+  font-weight: var(--font-weight-bp-bold);
+  letter-spacing: var(--tracking-bp-wide);
+  text-transform: uppercase;
+  padding: var(--spacing-bp-3) var(--spacing-bp-6);
+  transition: var(--transition-bp-colors), var(--transition-bp-shadow);
+  cursor: pointer;
+  border: none;
+  outline: none;
+
+  &:hover {
+    background-image: var(--gradient-bp-integrity-hover);
+    box-shadow: var(--shadow-bp-lift);
+  }
+
+  &:focus-visible {
+    outline: 2px solid var(--outline-bp-focus);
+    outline-offset: 2px;
+  }
+}
+
+/* ── Ghost Border (accessibility fallback only) ──────────────────── */
+@utility bp-ghost-border {
+  border: 1px solid var(--outline-bp-ghost);
+}
+
+/* ── Technical Shadow (ambient floating element) ─────────────────── */
+@utility bp-shadow-ambient {
+  box-shadow: var(--shadow-bp-ambient);
+}
+
+/* ── Glass Overlay Panel ─────────────────────────────────────────── */
+@utility bp-glass {
+  background-color: var(--color-bp-surface-glass);
+  backdrop-filter: blur(var(--blur-bp-glass));
+  -webkit-backdrop-filter: blur(var(--blur-bp-glass));
+}
+
+/* ── Geist Mono Data Display ─────────────────────────────────────── */
+@utility bp-mono {
+  font-family: var(--font-bp-mono);
+  letter-spacing: var(--tracking-bp-tight);
+}
+
+/* ── Editorial Headline (Space Grotesk, Industrial voice) ────────── */
+@utility bp-headline {
+  font-family: var(--font-bp-display);
+  line-height: var(--leading-bp-tight);
+  font-weight: var(--font-weight-bp-bold);
+  letter-spacing: var(--tracking-bp-tight);
+}
+
+/* ── Section Prefix Tag  "01 / SYSTEM STATUS" ────────────────────── */
+@utility bp-label-prefix {
+  font-family: var(--font-bp-mono);
+  font-size: var(--font-size-bp-xs);
+  font-weight: var(--font-weight-bp-bold);
+  letter-spacing: var(--tracking-bp-widest);
+  text-transform: uppercase;
+  color: var(--color-bp-neutral);
+}
+
+/* ── Command Strip surface (asymmetric editorial weight) ─────────── */
+@utility bp-command-strip {
+  background-color: var(--color-bp-surface-container-highest);
+}
+
+/* ── Input: active 2px bottom-bar state (primary_action indicator) ── */
+@utility bp-input-active {
+  border-bottom: 2px solid var(--color-bp-primary);
+  background-color: var(--color-bp-surface-container-lowest);
+  border-radius: 0;
+  transition: border-color var(--duration-bp-fast) var(--ease-bp-standard);
+}
+
+/* ── Row hover (list items & data grids — no dividers) ───────────── */
+@utility bp-row-hover {
+  transition: background-color var(--duration-bp-fast) var(--ease-bp-standard);
+
+  &:hover {
+    background-color: var(--color-bp-surface-container-low);
+  }
+}
+
+/* ── Information Chip / Technical Tag ────────────────────────────── */
+@utility bp-chip {
+  font-family: var(--font-bp-mono);
+  font-size: var(--font-size-bp-xs);
+  letter-spacing: var(--tracking-bp-tight);
+  background-color: var(--color-bp-surface-container-highest);
+  color: var(--color-bp-on-surface-variant);
+  padding: var(--spacing-bp-1) var(--spacing-bp-2);
+  border-radius: var(--radius-bp-none);
+  border: none;
+  display: inline-flex;
+  align-items: center;
+  gap: var(--spacing-bp-1);
+}
